# Executa ASP.NET Core como Vercel Function baseada em contêiner.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source
COPY Directory.Build.props LeitorDeJornal.sln ./
COPY src/ ./src/
RUN dotnet publish src/LeitorDeJornal.Web/LeitorDeJornal.Web.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /out ./
ENV ASPNETCORE_HTTP_PORTS=80
ENV ASPNETCORE_ENVIRONMENT=Production
ENV Storage__Directory=/tmp/journalreader
EXPOSE 80
ENTRYPOINT ["dotnet", "LeitorDeJornal.Web.dll"]
